{
  "name": "learn-qec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "video"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/qec_engine --target web --out-dir ../../packages/qec-wasm",
